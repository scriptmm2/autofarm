-- NIGHTFALL: one horizontal control surface. No skins, particles or summary window.
local holder=create("Frame",{Name="Holder",BackgroundTransparency=1,BorderSizePixel=0,
    AnchorPoint=Vector2.new(0.5,0.5),Position=UDim2.fromScale(0.5,0.5),
    Size=UDim2.fromOffset(WINDOW_WIDTH,WINDOW_HEIGHT)},screenGui)
local responsiveScale=create("UIScale",{Scale=UI_SCALE},holder)
local uiLayout={mainMoved=false,visibleHeight=WINDOW_HEIGHT}
local function boundPosition(position)
    local camera=workspace.CurrentCamera
    if not camera then return position end
    local viewport,scale=camera.ViewportSize,responsiveScale.Scale
    local halfW,halfH=WINDOW_WIDTH*scale/2,WINDOW_HEIGHT*scale/2
    local shown=(uiLayout.visibleHeight or WINDOW_HEIGHT)*scale
