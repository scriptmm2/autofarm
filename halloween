local function stopAutofarmOnDeath(character)
    if not state.alive then return end
    if characterDeathConnection then characterDeathConnection:Disconnect(); characterDeathConnection = nil end
    currentTarget = nil
    trackedBagLabel, lastSeenBagCount = nil, nil
    state.bagCount, state.bagFound = 0, false
    lastSafePosition, lastFramePosition, safePosAccumulator = nil, nil, 0
    bagKillTriggered = false
    bagStartFarmed = state.farmed
    if state.autofarm then
        state.farmPaused = true
        state.pauseReason = "RESPAWN"
    end
    local humanoid = character:FindFirstChildOfClass("Humanoid") or character:WaitForChild("Humanoid", 8)
    if not humanoid or not state.alive or player.Character ~= character then return end

    characterDeathConnection = humanoid.Died:Connect(function()
        currentTarget = nil
        state.farmPaused = state.autofarm
        state.pauseReason = state.autofarm and "RESPAWN" or ""
        restoreCharacter()
    end)
end

