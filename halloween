-- Single-window motion. No hidden/detached summary panel or decorative frame loop.
local foldMotion={value=0,from=0,target=0,elapsed=0,running=false}
local dragTarget=nil
local dragging=false
local dragInput,dragStart,holderStart
local function applyFoldVisuals(progress)
    local height=WINDOW_HEIGHT+(COLLAPSED_HEIGHT-WINDOW_HEIGHT)*math.clamp(progress,0,1)
    window.Size=UDim2.fromOffset(WINDOW_WIDTH,height)
    shadow.Size=window.Size
    ui.rim.Size=window.Size
    content.Size=UDim2.fromOffset(WINDOW_WIDTH,math.max(0,height-COLLAPSED_HEIGHT-8))
    content.Visible=progress<1
    uiLayout.visibleHeight=height
    ui.blockInput=foldMotion.running
    clampWindow()
end
local function updateFold(dt)
    if not foldMotion.running then return end
    foldMotion.elapsed=math.min(MOTION_SETTINGS.FoldDuration,foldMotion.elapsed+dt)
    local t=foldMotion.elapsed/MOTION_SETTINGS.FoldDuration
    foldMotion.value=foldMotion.from+(foldMotion.target-foldMotion.from)*(1-math.cos(t*math.pi))/2
    if t>=1 then foldMotion.value,foldMotion.running=foldMotion.target,false end
    applyFoldVisuals(foldMotion.value)
end
local function updateDrag(dt)
    if not dragTarget then return end
    dragTarget=boundPosition(dragTarget)
    local camera=workspace.CurrentCamera
    if not camera then return end
    local p,v=holder.Position,camera.ViewportSize
    local x,y=p.X.Scale*v.X+p.X.Offset,p.Y.Scale*v.Y+p.Y.Offset
    local dx,dy=dragTarget.X.Offset-x,dragTarget.Y.Offset-y
    if math.abs(dx)+math.abs(dy)<0.2 then holder.Position=dragTarget;dragTarget=nil
    else
        local a=1-math.exp(-MOTION_SETTINGS.DragResponse*dt)
        holder.Position=UDim2.fromOffset(x+dx*a,y+dy*a)
    end
end
local function pointInside(object,p)
    local a,s=object.AbsolutePosition,object.AbsoluteSize
    return p.X>=a.X and p.X<=a.X+s.X and p.Y>=a.Y and p.Y<=a.Y+s.Y
end
connect(header.InputBegan,function(input)
    if state.closing or (input.UserInputType~=Enum.UserInputType.MouseButton1 and input.UserInputType~=Enum.UserInputType.Touch) then return end
    if pointInside(minimizeButton,input.Position) or pointInside(closeButton,input.Position) then return end
    uiLayout.mainMoved=true
    dragging,dragInput,dragStart,holderStart=true,input,input.Position,holder.Position
    dragTarget=nil
end)
connect(UserInputService.InputChanged,function(input)
    if not dragging or not dragInput then return end
    local mouse=input.UserInputType==Enum.UserInputType.MouseMovement
    local touch=dragInput.UserInputType==Enum.UserInputType.Touch and input==dragInput
    if mouse or touch then
        local delta=input.Position-dragStart
        dragTarget=boundPosition(UDim2.new(holderStart.X.Scale,holderStart.X.Offset+delta.X,holderStart.Y.Scale,holderStart.Y.Offset+delta.Y))
    end
end)
connect(UserInputService.InputEnded,function(input)
    if not dragInput then return end
    if input==dragInput or (dragInput.UserInputType==Enum.UserInputType.MouseButton1 and input.UserInputType==Enum.UserInputType.MouseButton1) then
        dragging,dragInput=false,nil
    end
end)
local function releaseInput()
    dragging,dragInput,dragTarget=false,nil,nil
    sliderDragging,sliderInput=false,nil
    smoothTween(sliderKnob,0.12,{Size=UDim2.fromOffset(14,14)})
end
connect(UserInputService.WindowFocusReleased,releaseInput)
local function setMinimized(value)
    if state.closing or state.minimized==value then return end
    state.minimized=value
    sliderDragging,sliderInput=false,nil
    smoothTween(sliderKnob,0.12,{Size=UDim2.fromOffset(14,14)})
    minimizeButton.Text=value and "+" or "-"
    foldMotion.from,foldMotion.target=foldMotion.value,value and 1 or 0
    foldMotion.elapsed,foldMotion.running=0,true
    ui.blockInput=true
end
connect(minimizeButton.Activated,function() setMinimized(not state.minimized) end)
connect(closeButton.Activated,function()
    if state.closing then return end
    state.closing=true;state.autofarm=false
    releaseInput();restoreCharacter()
    foldMotion.from,foldMotion.target=foldMotion.value,1
    foldMotion.elapsed,foldMotion.running=0,true
    task.delay(MOTION_SETTINGS.FoldDuration+0.02,function()
        cleanup()
        if screenGui.Parent then screenGui:Destroy() end
    end)
end)
function ui:syncStatus()
    local text,color="READY",Theme.Muted
    if state.autofarm then
        text=state.farmPaused and state.pauseReason or "FARMING"
        if text=="" then text="WAITING" end
        color=state.farmPaused and Theme.Gold or Theme.Green
    end
    self:write(self.farmStatus,"Text",text)
    self:write(self.farmStatus,"TextColor3",color)
    self:write(self.farmDot,"BackgroundColor3",color)
end
local bagAccumulator=0
connect(RunService.Heartbeat,function(dt)
    if not state.alive or state.closing then return end
    bagAccumulator+=dt
    if bagAccumulator>=0.2 then
        bagAccumulator%=0.2
        -- Internal bag state is still required by Auto Respawn. Nothing is displayed.
        updateBagFromInterface()
        killCharacterWhenBagIsFull()
        ui:syncStatus()
    end
end)
connect(RunService.RenderStepped,function(dt)
    if not state.alive then return end
    if foldMotion.running then updateFold(dt) end
    if dragTarget then updateDrag(dt) end
    if math.abs(targetProgress-displayedProgress)>0.0005 then
        displayedProgress+=(targetProgress-displayedProgress)*(1-math.exp(-32*dt))
        if math.abs(targetProgress-displayedProgress)<=0.0005 then displayedProgress=targetProgress end
        sliderFill.Size=UDim2.fromScale(displayedProgress,1)
        sliderKnob.Position=UDim2.new(displayedProgress,0,0.5,0)
    end
end)
foldMotion.value,foldMotion.from,foldMotion.target=1,1,0
foldMotion.elapsed,foldMotion.running=0,true
applyFoldVisuals(1)
ui:syncStatus()
refreshViewport()
